{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BurnISO to USB",
  "version": "1.4.3",
  "identifier": "com.burniso.usb",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BurnISO to USB",
        "width": 900,
        "height": 900,
        "minWidth": 700,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "devtools": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Developer ID Application: Norbert Jander (TXF2V79Z6N)",
      "hardenedRuntime": true
    },
    "category": "public.app-category.utilities",
    "shortDescription": "ISO to USB Brenner und USB Backup Tool",
    "longDescription": "Ein einfaches Tool zum Brennen von ISO-Images auf USB-Sticks und zum Erstellen von USB-Backups unter macOS."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4RDc2MkYxRTVBMkMwM0IKUldRN3dLTGw4V0xYMkhMZHRwVVgrVE9DL3p3Q2dWUGlJTFZxWUhZQzZNYlZWTUFKZ241V08yRWcK",
      "endpoints": [
        "https://github.com/nojan01/burniso-tauri/releases/latest/download/latest.json"
      ]
    }
  }
}
